# Environment variables for docker-management-stack
WATCHTOWER_CLEANUP=true
WATCHTOWER_POLL_INTERVAL=300

# Telegram notifications (optional — leave empty to disable)
WATCHTOWER_NOTIFICATIONS=
WATCHTOWER_NOTIFICATION_URL=

DOMAIN=example.com

# Traefik middlewares for admin routes: authelia@docker with the auth stack,
# traefik-auth@docker (basic auth) without it
ADMIN_MIDDLEWARES=authelia@docker
