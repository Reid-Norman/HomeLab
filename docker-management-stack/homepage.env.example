# Environment for the homepage container only (rendered from homepage.env.j2).
# Values are usable as {{HOMEPAGE_VAR_*}} in ./homepage/*.yaml
HOMEPAGE_VAR_DOMAIN=example.com
HOMEPAGE_VAR_SONARR_KEY=your-sonarr-api-key
HOMEPAGE_VAR_RADARR_KEY=your-radarr-api-key
HOMEPAGE_VAR_PROWLARR_KEY=your-prowlarr-api-key
HOMEPAGE_VAR_JELLYFIN_KEY=your-jellyfin-api-key
HOMEPAGE_VAR_QBITTORRENT_USER=your-qbittorrent-user
HOMEPAGE_VAR_QBITTORRENT_PASS=your-qbittorrent-password
HOMEPAGE_VAR_ADGUARD_USER=your-adguard-user
HOMEPAGE_VAR_ADGUARD_PASS=your-adguard-password
