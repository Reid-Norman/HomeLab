# Homepage environment. Generated by the Ansible env_files role — do not edit manually.
# Only the homepage container loads this file, so these keys and logins don't reach
# the other management services. Each HOMEPAGE_VAR_* is usable as {{ '{{' }}HOMEPAGE_VAR_*{{ '}}' }}
# in ./homepage/*.yaml. Widgets whose key is still a placeholder show an API error
# until `make extract-keys` (or the Jellyfin API key step in docs/access.md) fills it in

HOMEPAGE_VAR_DOMAIN={{ vault_domain }}
HOMEPAGE_VAR_SONARR_KEY={{ sonarr_api_key | default('') }}
HOMEPAGE_VAR_RADARR_KEY={{ radarr_api_key | default('') }}
HOMEPAGE_VAR_PROWLARR_KEY={{ prowlarr_api_key | default('') }}
HOMEPAGE_VAR_JELLYFIN_KEY={{ vault_jellyfin_api_key | default('') }}
HOMEPAGE_VAR_QBITTORRENT_USER={{ qbittorrent_username | default('') }}
HOMEPAGE_VAR_QBITTORRENT_PASS={{ qbittorrent_password | default('') | replace('$', '$$') }}
HOMEPAGE_VAR_ADGUARD_USER={{ adguard_username | default('') }}
HOMEPAGE_VAR_ADGUARD_PASS={{ adguard_password | default('') | replace('$', '$$') }}
