# Docker Auth Stack Environment Variables
# Copy to .env and fill in real values, or use `make ansible-sync` to generate from vault.

DOMAIN=example.com

# Authelia secrets: random strings of 64+ characters (make generate-creds STACK=auth)
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=replace_with_random_64_chars
AUTHELIA_SESSION_SECRET=replace_with_random_64_chars
AUTHELIA_STORAGE_ENCRYPTION_KEY=replace_with_random_64_chars
