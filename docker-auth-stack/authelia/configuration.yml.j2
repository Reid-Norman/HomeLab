# Authelia configuration. Generated by the Ansible env_files role from
# configuration.yml.j2 — do not edit configuration.yml directly.
# Secrets come from AUTHELIA_* environment variables in .env

theme: auto

server:
  address: "tcp://:9091"

log:
  level: info

totp:
  issuer: "{{ vault_domain }}"

authentication_backend:
  file:
    path: /config/users_database.yml
    password:
      algorithm: argon2

access_control:
  # Anything not matched below is refused
  default_policy: deny
  rules:
    - domain: "*.{{ vault_domain }}"
      subject: "group:admins"
      policy: two_factor

session:
  # One cookie on the apex domain: logging in once covers every subdomain
  cookies:
    - domain: "{{ vault_domain }}"
      authelia_url: "https://auth.{{ vault_domain }}"
{% if authelia_default_redirection_url | default('') %}
      default_redirection_url: "{{ authelia_default_redirection_url }}"
{% endif %}

# Brute-force protection: 3 failed logins within 2 minutes bans the user for 10
regulation:
  max_retries: 3
  find_time: 2m
  ban_time: 10m

storage:
  local:
    path: /data/db.sqlite3

# No email server: one-time codes and setup links are written to this file
# (docker exec authelia cat /data/notification.txt)
notifier:
  filesystem:
    filename: /data/notification.txt
