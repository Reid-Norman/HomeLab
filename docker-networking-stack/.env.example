# Docker Networking Stack Environment Variables
# Copy to .env and fill in real values, or use `make ansible-sync` to generate from vault.

# Traefik
DOMAIN=example.com
LE_EMAIL=your_email@example.com
CF_DNS_API_TOKEN=your_cloudflare_dns_api_token
CF_API_EMAIL=your_cloudflare_email@example.com
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$...  # output of: htpasswd -nbB admin yourpassword

# Cloudflare Tunnel (profile "tunnel")
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token  # only needed with the "tunnel" profile

# Traefik middlewares for admin routes: authelia@docker with the auth stack,
# traefik-auth@docker (basic auth) without it
ADMIN_MIDDLEWARES=authelia@docker

# Static IP: qBittorrent trusts requests from this address (they passed Authelia)
TRAEFIK_STATIC_CONTAINER_IP=172.20.0.202
