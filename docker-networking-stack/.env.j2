# Docker Networking Stack Environment Variables
# Generated by Ansible env_files role — do not edit manually.

# Traefik
DOMAIN={{ vault_domain }}
LE_EMAIL={{ vault_le_email }}
CF_DNS_API_TOKEN={{ vault_cf_dns_api_token }}
CF_API_EMAIL={{ vault_cf_api_email }}
TRAEFIK_DASHBOARD_AUTH={{ vault_traefik_dashboard_password | replace('$', '$$') }}

# Cloudflare Tunnel (profile "tunnel")
CLOUDFLARE_TUNNEL_TOKEN={{ vault_cloudflare_tunnel_token | default('') }}

# Traefik middlewares for admin routes (set in vars.yml: traefik_admin_middlewares)
ADMIN_MIDDLEWARES={{ traefik_admin_middlewares }}

# Static IP: qBittorrent trusts requests from this address (they passed Authelia)
TRAEFIK_STATIC_CONTAINER_IP={{ traefik_static_ip }}
